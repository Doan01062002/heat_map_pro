# ==============================================================================
# Real-Time Driver Deviation Heatmap — Environment Variables
# ==============================================================================
# Copy this file to .env and fill in the values.
# DO NOT commit .env to version control.
# ==============================================================================

# ---- General ----
APP_ENV=development                    # development | production
LOG_LEVEL=debug                        # debug | info | warn | error

# ---- Go Backend ----
BACKEND_PORT=8080                      # HTTP + WebSocket port for Go server
BACKEND_HOST=0.0.0.0                   # Bind address

# ---- OSRM ----
OSRM_URL=http://osrm:5000             # OSRM HTTP API base URL (Docker service name)
OSRM_MATCH_TIMEOUT_MS=500             # Timeout for match API calls (milliseconds)

# ---- Redis ----
REDIS_ADDR=redis:6379                  # Redis host:port
REDIS_PASSWORD=                        # Redis password (empty for no auth)
REDIS_DB=0                             # Redis database number
REDIS_CHANNEL=heatmap:updates          # Pub/Sub channel name for heatmap events

# ---- PostgreSQL + PostGIS ----
POSTGRES_HOST=postgres                 # Database host
POSTGRES_PORT=5432                     # Database port
POSTGRES_USER=heatmap                  # Database user
POSTGRES_PASSWORD=heatmap_secret_2024  # Database password (CHANGE IN PRODUCTION)
POSTGRES_DB=heatmap_db                 # Database name
POSTGRES_SSLMODE=disable              # SSL mode (disable for Docker internal network)

# ---- H3 Spatial Indexing ----
H3_RESOLUTION=8                        # H3 resolution level (8 = ~460m diameter hexagons)

# ---- Aggregation Timing ----
FLUSH_INTERVAL_REDIS_MS=1000           # Flush aggregated data to Redis every N ms
FLUSH_INTERVAL_POSTGRES_S=30           # Flush to PostgreSQL every N seconds

# ---- Bounding Box Pre-Filter ----
BBOX_BUFFER_METERS=50                  # Buffer distance around planned route (meters)
DEVIATION_THRESHOLD_METERS=50          # Minimum distance to flag as deviation

# ---- Frontend (Build-time) ----
VITE_WS_URL=ws://localhost:8080/ws     # WebSocket URL for frontend apps
VITE_API_URL=http://localhost:8080/api # REST API URL for history queries
VITE_MAP_STYLE=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
                                       # MapLibre style URL (free, no API key)

# ---- OSRM Map Data ----
OSRM_MAP_URL=https://download.geofabrik.de/asia/vietnam-latest.osm.pbf
OSRM_MAP_FILE=vietnam-latest.osm.pbf  # Filename for the OSM data

# ---- AI Agent Service ----
AI_AGENT_URL=http://ai-agent:8090       # Python AI Agent Service URL
GROQ_API_KEY=your_groq_api_key_here            # Groq API key (LLaMA 3.3 70B)
GEMINI_API_KEY=                          # Google AI Studio API key (fallback)


